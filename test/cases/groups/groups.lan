-- Groups without a target, a variable that is already dimensionless, a
-- vector (its components' dimension counts), and more groups than one.
theory Many
  dim M, L, T
  var ρ : M/L^3
  var v : L/T
  var D, h : L
  var μ : M/(L*T)
  var u : L/T, vector(3)
  var α : 1
  groups flow: ρ, v, D, μ, h, u, α
end

-- Only independent dimensions: no groups, and nothing can appear.
theory Independent
  dim M, L, T
  var m : M
  var x : L
  var t : T
  groups none: m, x, t
end

-- A target that needs fractional powers of three variables.
theory Fractional
  dim M, L, T
  var f : 1/T                -- a string's frequency
  var F : M*L/T^2            -- its tension
  var λ : M/L                -- its mass per length
  var ℓ : L
  groups string: f from F, λ, ℓ
end
